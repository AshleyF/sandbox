# Dropbox app credentials.
# Create an app at https://www.dropbox.com/developers/apps and copy the values here.
# The refresh token is obtained once via the OAuth flow (see caption.py for the flow).
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_ACCESS_TOKEN=    # optional; will be refreshed from refresh token if blank

# Comma-separated list of Dropbox root paths to enumerate.
# Use "/" to walk the entire Dropbox.
DROPBOX_ROOTS=/Photos,/Camera Uploads,/Photography

# Number of records per batch_*.json file.
BATCH_SIZE=500

# Prompt sent to the Copilot CLI vision model for each photo.
CAPTION_PROMPT=Caption this image in 1-2 sentences.

# How long (seconds) to wait for a single Copilot caption call before retrying.
COPILOT_TIMEOUT=180

# Number of parallel caption workers. 4 is a good default.
WORKERS=4
